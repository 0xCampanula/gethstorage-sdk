{
  "name": "gethstorage-sdk",
  "version": "5.0.3",
  "description": "EthStorage flat directory upload sdk (calldata only)",
  "files": [
    "dist"
  ],
  "main": "./dist/node/index.cjs",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser/index.mjs",
      "node": {
        "import": "./dist/node/index.mjs",
        "require": "./dist/node/index.cjs"
      },
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.mjs"
    },
    "./file": {
      "node": {
        "import": "./dist/node/file.mjs",
        "require": "./dist/node/file.cjs"
      },
      "types": "./dist/node/file.d.ts"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch --env.NODE_ENV development",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "p-limit": "^7.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xCampanula/gethstorage-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/0xCampanula/gethstorage-sdk/issues"
  },
  "homepage": "https://github.com/0xCampanula/gethstorage-sdk/main/",
  "keywords": [
    "File",
    "Upload"
  ],
  "author": "ethsorage",
  "license": "ISC",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "strip-ansi": "7.1.0",
    "color-convert": "2.0.1",
    "color-name": "1.1.4"
  },
  "overrides": {
    "rollup": ">=4.59.0",
    "picomatch": ">=4.0.4"
  }
}
